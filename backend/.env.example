# ===============================================
# AgentGuard Environment Configuration
# ===============================================

# Secret Management Architecture ('env', 'vault', 'aws', 'gcp')
# Defaults to 'env' for standard local development and container deployments.
# In production, set to 'vault', 'aws', or 'gcp' to dynamically fetch secrets without plaintext disk storage.
SECRET_PROVIDER=env

# HashiCorp Vault Settings (only used if SECRET_PROVIDER=vault)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_PATH=secret/data/agentguard

# AWS Secrets Manager Settings (only used if SECRET_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_SECRET_ID=agentguard/production

# GCP Secret Manager Settings (only used if SECRET_PROVIDER=gcp)
GCP_PROJECT_ID=
GCP_SECRET_PREFIX=agentguard_

# Moss Credentials (obtain from https://moss.dev)
# If using Vault/AWS/GCP, these can be populated automatically from the secret manager.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Set to "false" once you have filled in real MOSS_PROJECT_ID & KEY
# Defaults to "true" to enable seamless offline local development & demo
MOSS_MOCK_FALLBACK=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# CORS Allowed Origins (comma-separated list, or '*' to allow all origins)
CORS_ORIGINS=*

# SQLite Database Path Configuration:
# - Render Free Plan (Ephemeral Storage, no disk mounted): /tmp/agentguard.db
# - Render Paid / Production (with Persistent Disk mounted at /var/data): /var/data/agentguard.db
# - Docker / Compose (using container volume /app/data): /app/data/agentguard.db
# - Local development (default relative file in backend folder): leave blank or agentguard.db
# Note: When running as an unprivileged user, ensure the parent directory is writable.
# If an unwritable path is provided without disk mount, AgentGuard safely falls back to /tmp/agentguard.db.
SQLITE_DB_PATH=

# Optional Secondary LLM Arbiter (for ambiguous edge-case policy reasoning)
GEMINI_API_KEY=
