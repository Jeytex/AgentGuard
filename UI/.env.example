# ===============================================
# AgentGuard Console Frontend Environment Configuration
# ===============================================

# Production REST API Base URL (must end with /api/v1)
# Example: https://api.agentguard.example.com/api/v1
NEXT_PUBLIC_AGENTGUARD_API_URL=http://localhost:8000/api/v1

# Production WebSocket Event Stream URL (must end with /api/v1/events/ws)
# Use wss:// for production SSL/TLS deployments
# Example: wss://api.agentguard.example.com/api/v1/events/ws
NEXT_PUBLIC_AGENTGUARD_WS_URL=ws://localhost:8000/api/v1/events/ws
